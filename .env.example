[TEMPLATE]
# Application Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# JWT Configuration
# IMPORTANT: This MUST match the JWT_SECRET used by backend/apps/identity-service.
# The identity-service signs tokens; the media-backend verifies them.
# Both must share the exact same secret for cross-repo auth to work.
JWT_SECRET=inclusaai-dev-jwt-secret-change-in-production

# LiveKit Configuration
LIVEKIT_SERVER_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Kafka Configuration
#
# Variable names are identical to ai-services
# (shared/kafka_clients/.../security.py) so both ends of the media firehose are
# configured from one contract. See KAFKA_SETUP.md in ai-services for the
# Aiven walkthrough.
#
# --- Local dev (Redpanda from docker-compose.dev.yml) ---
# Uncomment for a plaintext local broker:
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#
# --- Managed broker (Aiven) ---
# KAFKA_BOOTSTRAP_SERVERS=kafka-<name>-<id>.l.aivencloud.com:<port>
KAFKA_SECURITY_PROTOCOL=SASL_SSL
# SASL mechanism; Aiven's default is SCRAM-SHA-256.
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_USERNAME=<sasl-username>
KAFKA_PASSWORD=<sasl-password>
# Aiven signs its TLS chain with a private CA that is NOT in the system trust
# store, so this must be set or the handshake fails with
# "unable to get local issuer certificate".
#
# Accepts either a path to a PEM file:
#   KAFKA_CA_CERT=C:/path/to/aiven-kafka-ca.pem
# or the inline PEM body (required on single-file hosts like Render, where
# there is nowhere to mount a file):
#   KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
KAFKA_CA_CERT=

# Topic provisioning. The `media.session.<id>.*` topics are per-session and are
# created on `session.created`, because managed brokers ship with topic
# auto-creation disabled. These match the existing `ai.*` topics (3 partitions,
# 3 replicas); local single-broker Redpanda falls back to 1 replica
# automatically.
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=3

# LIVEKIT_WEBHOOKS_ENABLED=true  # set once LiveKit can reach /api/livekit/webhook

# ai-services HTTP endpoints (deployed on Render).
# Off the media hot path — media travels over Kafka. Reported in GET /health
# for diagnostics; not probed (Render free tier cold-starts for ~50s).
SIGN_RECOGNITION_SERVICE_URL=https://sign-recognition-service.onrender.com
AVATAR_POSE_SERVICE_URL=https://avatar-pose-service.onrender.com

# Redis Configuration
# Connects to the canonical Redis from backend/docker-compose.dev.yml
REDIS_URL=redis://localhost:6379

# Egress WebSocket host (for LiveKit Egress to stream media back)
EGRESS_WS_HOST=localhost

# Recording Configuration
RECORDING_ENABLED=true
RECORDING_OUTPUT_PATH=./recordings

# Audio Configuration (MVP - Speech Transcription)
AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=opus

# Video Configuration (MVP - Sign Recognition)
VIDEO_SAMPLE_RATE_FPS=15
VIDEO_ENCODING=h264

# Session Configuration
SESSION_RECONNECT_GRACE_PERIOD_MS=30000
SESSION_TIMEOUT_MS=3600000

# Metrics Configuration
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Service Discovery
SERVICE_NAME=realtime-media-backend
SERVICE_VERSION=1.0.0
