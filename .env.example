# Application Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# LiveKit Configuration
LIVEKIT_SERVER_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Kafka Configuration
KAFKA_BROKERS=localhost:9092

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Recording Configuration
RECORDING_ENABLED=true
RECORDING_OUTPUT_PATH=./recordings

# Audio Configuration (MVP - Speech Transcription)
AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=opus

# Video Configuration (MVP - Sign Recognition)
VIDEO_SAMPLE_RATE_FPS=15
VIDEO_ENCODING=h264

# Session Configuration
SESSION_RECONNECT_GRACE_PERIOD_MS=30000
SESSION_TIMEOUT_MS=3600000

# Metrics Configuration
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Service Discovery
SERVICE_NAME=realtime-media-backend
SERVICE_VERSION=1.0.0
